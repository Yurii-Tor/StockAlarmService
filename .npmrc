# vitest declares its browser providers and UI as OPTIONAL peers with exact
# versions. npm resolves them to "latest" anyway, drags the vitest-5 providers
# into our vitest-4 tree (required by @cloudflare/vitest-pool-workers), then
# either crashes arborist or exhausts the heap trying to reconcile the peer set.
# We install none of those providers, so skip peer auto-resolution entirely.
# Every dependency we actually use is declared explicitly in package.json.
legacy-peer-deps=true
